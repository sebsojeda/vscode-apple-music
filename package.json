{
  "name": "vscode-apple-music",
  "displayName": "Apple Music Player",
  "description": "Apple Music client for Visual Studio Code",
  "repository": {
    "url": "https://github.com/sebsojeda/vscode-apple-music"
  },
  "extensionKind": [
    "ui"
  ],
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "publisher": "sebsojeda",
  "version": "1.8.0",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Apple Music Player Settings",
      "properties": {
        "vscodeAppleMusic.statusBarLayout": {
          "type": "string",
          "enum": [
            "compact",
            "full",
            "trackOnly"
          ],
          "enumDescriptions": [
            "Play/Pause + Now Playing",
            "Previous + Play/Pause + Next + Now Playing + Mute",
            "Now Playing only"
          ],
          "default": "compact",
          "description": "Choose which Apple Music controls appear in the status bar."
        },
        "vscodeAppleMusic.volumeStep": {
          "type": "number",
          "default": 6.25,
          "minimum": 0.5,
          "maximum": 100,
          "description": "The step size for volume control."
        },
        "vscodeAppleMusic.seekStep": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 600,
          "description": "The number of seconds to seek forward or backward."
        },
        "vscodeAppleMusic.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show the Apple Music status bar controls on startup."
        },
        "vscodeAppleMusic.autoPlayWorkspaceSoundtrack": {
          "type": "boolean",
          "default": false,
          "description": "Automatically play the selected soundtrack when its workspace opens."
        }
      }
    },
    "commands": [
      {
        "command": "vscode-apple-music.previousTrack",
        "title": "Previous Track",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.nextTrack",
        "title": "Next Track",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.playPauseTrack",
        "title": "Play/Pause",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.playTrack",
        "title": "Play",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.pauseTrack",
        "title": "Pause",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.muteUnmuteTrack",
        "title": "Mute/Unmute",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.muteTrack",
        "title": "Mute",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.unmuteTrack",
        "title": "Unmute",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.open",
        "title": "Open Music",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.quit",
        "title": "Quit",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.volumeUp",
        "title": "Volume Up",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.volumeDown",
        "title": "Volume Down",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.toggleRepeat",
        "title": "Toggle Repeat",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.toggleShuffle",
        "title": "Toggle Shuffle",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.showPlayer",
        "title": "Show Player",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.hidePlayer",
        "title": "Hide Player",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.addToLibrary",
        "title": "Add to Library",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.addToPlaylist",
        "title": "Add to Playlist",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.playPlaylist",
        "title": "Play Playlist",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.shufflePlaylist",
        "title": "Shuffle Playlist",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.showNowPlaying",
        "title": "Show Now Playing Actions",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.favoriteTrack",
        "title": "Favorite Track",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.unfavoriteTrack",
        "title": "Unfavorite Track",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.toggleFavorite",
        "title": "Toggle Favorite",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.searchLibrary",
        "title": "Search Apple Music",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.seekForward",
        "title": "Seek Forward",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.seekBackward",
        "title": "Seek Backward",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.restartTrack",
        "title": "Restart Track",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.setVolume",
        "title": "Set Volume",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.setRepeatMode",
        "title": "Set Repeat Mode",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.copyTrackInfo",
        "title": "Copy Track Info",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.revealCurrentTrack",
        "title": "Reveal Current Track in Music",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.toggleStatusBarControls",
        "title": "Toggle Status Bar Controls",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.selectWorkspaceSoundtrack",
        "title": "Select Workspace Soundtrack",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.clearWorkspaceSoundtrack",
        "title": "Clear Workspace Soundtrack",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.playWorkspaceSoundtrack",
        "title": "Play Workspace Soundtrack",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.manageWorkspaceSoundtrack",
        "title": "Workspace Soundtrack…",
        "category": "Apple Music"
      },
      {
        "command": "vscode-apple-music.checkSetup",
        "title": "Check Setup",
        "category": "Apple Music"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vscode-apple-music.playTrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.pauseTrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.muteTrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.unmuteTrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.favoriteTrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.unfavoriteTrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.toggleRepeat",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.shufflePlaylist",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.playPlaylist",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.showPlayer",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.hidePlayer",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.selectWorkspaceSoundtrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.clearWorkspaceSoundtrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.playWorkspaceSoundtrack",
          "when": "false"
        },
        {
          "command": "vscode-apple-music.quit",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "14.x",
    "@types/vscode": "^1.66.0",
    "@typescript-eslint/eslint-plugin": "^5.16.0",
    "@typescript-eslint/parser": "^5.16.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.11.0",
    "typescript": "^4.5.5"
  },
  "dependencies": {}
}
